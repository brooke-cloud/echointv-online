generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  
}

model Problem {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  company         String
  role            String
  difficulty      String
  stage           String   @default("VO") // 🌟 必须加上这一行
  category        String
  description     String
  example         String
  approach        String
  solution        String
  similarProblems String?  // 🌟 新增：LeetCode 相似题目（如: "373. 查找和最小的 K 对数字, 378. 有序矩阵中第 K 小的元素"）
  timeComplexity  String
  spaceComplexity String
  topics          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress        UserProblemProgress[]
  favorites       Favorite[]

  @@index([company])
  @@index([category])
  @@index([difficulty])
  @@index([createdAt])
}

model Post {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  company     String?  // 🌟 新增：独立目标公司字段 (如 IBM, Google, Meta)
  description String
  content     String?
  category    String
  date        String
  readingTime String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // 加密后的密码哈希
  role      String   @default("USER") // USER 或 ADMIN
  proStartedAt DateTime? // 🌟 会员开通/购买时间
  proExpiresAt DateTime? // 🌟 会员到期时间
  isVip     Boolean  @default(false)  // 🌟 新增：VIP 会员状态标识（true: VIP, false: 普通用户）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress  UserProblemProgress[]
  favorites Favorite[]

  @@index([email])
}

model UserProblemProgress {
  id        Int      @id @default(autoincrement())
  userId    String
  problemId Int
  status    String   @default("SOLVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  problemId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}


model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}


// prisma/schema.prisma (Job 模型部分)

model Job {
  id              String    @id @default(cuid())
  companyId       String?   // 关联 Company
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // 关键去重字段：ATS + 外部 Job ID (设为可选与默认值，平滑兼容旧数据)
  ats             String    @default("custom")
  externalJobId   String?   // String? 允许旧数据安全过渡，同时严格保障新数据唯一性
  companyName     String    @default("")
  companySlug     String    @default("")

  // 核心信息
  title           String
  location        String    @default("US")
  locations       String[]  @default([])
  isRemote        Boolean   @default(false)
  department      String?
  team            String?
  employmentType  String?
  track           String    @default("Fullstack")
  level           String?
  salary          String?
  description     String?   @db.Text

  // 官方直达链接
  jobUrl          String    @default("")
  applyUrl        String    @default("")

  // 生命周期时间戳
  postedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  isActive        Boolean   @default(true)

  // 唯一约束：彻底防止同名、多地区岗位重复插入
  @@unique([ats, externalJobId])

  // 核心查询索引
  @@index([isActive, track, postedAt(sort: Desc)])
  @@index([companySlug, isActive])
  @@index([isRemote])
  @@index([lastSeenAt])
}

model Company {
  id             String    @id @default(cuid())
  name           String    @unique // 公司名称
  slug           String    @unique // URL slug
  logoUrl        String?
  careersUrl     String    // 官网招聘主页
  atsType        String    // GREENHOUSE | LEVER | ASHBY | CUSTOM
  atsIdentifier  String    // ATS 识别号
  tier           String?   @default("HIGH_GROWTH")
  lastSyncedAt   DateTime?
  syncStatus     String    @default("IDLE")
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jobs           Job[]

  @@index([atsType])
}